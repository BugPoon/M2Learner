                title: "鏈式法則：洋蔥剝皮法",
                content: `
                    <p>複合函數求導時，我們從最外層一直微分到最內層，就像剝洋蔥一樣，每剝一層就乘以上一層的導數。</p>
                    <p>例子：$y = \\sin^3(2x) = (\\sin(2x))^3$</p>
                    <ul class="list-decimal list-inside space-y-1">
                        <li>第一層 (外層3次方)：$3(\\sin(2x))^2$</li>
                        <li>第二層 (sin)：$\\cos(2x)$</li>
                        <li>第三層 (2x)：$2$</li>
                    </ul>
                    <p>相乘得：$y' = 3\\sin^2(2x) \\cdot \\cos(2x) \\cdot 2 = 6\\sin^2(2x)\\cos(2x)$</p>
                `
            },
            implicit: {
                title: "隱函數與對數求導法",
                content: `
                    <p><strong>隱函數：</strong><br>遇到 $y$ 的函數時，正常求導後必須掛上一個 $\\frac{dy}{dx}$。<br>例如：$\\frac{d}{dx}(y^3) = 3y^2 \\frac{dy}{dx}$。</p>
                    
                    <p class="mt-4"><strong>對數求導法：</strong><br>處理 $x^x$ 或繁複的分式相乘時使用。</p>
                    <ul class="list-decimal list-inside space-y-1 text-sm">
                        <li>兩邊取 $\\ln$。</li>
                        <li>利用對數性質 ($\\ln(ab) = \\ln a + \\ln b$, $\\ln(a^b) = b\\ln a$) 化簡。</li>
                        <li>隱函數求導 $\\frac{1}{y}\\frac{dy}{dx} = \\dots$</li>
                        <li>把 $y$ 乘過去並代回原來的 $x$ 函數。</li>
                    </ul>
                `
            },
            second_deriv: {
                title: "顯函數二階導數 (Second Derivative)", 
                content: `
                    <p><strong>定義：</strong> 二階導數是指對一個函數連續求導兩次。它反映了變化率的變化率（例如物理中的加速度），以及圖形的凹凸性。</p>
                    
                    <p class="text-blue-700 bg-blue-50 p-3 rounded-lg border border-blue-100 my-2">
                        符號表示：$y''$, $f''(x)$, 或是 $\\frac{d^2y}{dx^2}$
                    </p>
                    <p><strong>計算範例：</strong><br>
                    設 $f(x) = x^4 - 3x^2$<br>
                    一階導數：$f'(x) = 4x^3 - 6x$<br>
                    二階導數：$f''(x) = \\frac{d}{dx}(4x^3 - 6x) = 12x^2 - 6$
                    </p>
                ` 
            
            }
        };

        function openFormulaModal(type) {
            const data = formulaData[type];
            document.getElementById('panel-title').innerText = data.title;
            document.getElementById('panel-content').innerHTML = data.content;
            
            const panel = document.getElementById('formula-detail-panel');
            panel.classList.remove('hidden');
            initMathOnElement(panel);
            panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function closeFormulaPanel() {
            document.getElementById('formula-detail-panel').classList.add('hidden');
        }

        function initKaTeX() {
            initMathOnElement(document.body);
        }

        function initMathOnElement(element) {
            if (typeof renderMathInElement !== 'undefined') {
                renderMathInElement(element, {
                    delimiters: [
                        {left: "$$", right: "$$", display: true},
                        {left: "$", right: "$", display: false}
                    ],
                    throwOnError: false
                });
            }
        }

        // ==================== CANVAS VISUALIZER LOGIC ====================
        // ==================== DYNAMIC MATH.JS ENGINE ====================
        const $ = id => document.getElementById(id);
        let chart = null;
        let currentAst = null;       // 儲存 math.js 解析後的 AST
        let currentRule = '';        // 系統判定的最外層法則
        let currentSteps = [];       // 動態生成的 4 個步驟
        let compiledFunc = null;     // 編譯後的原函數 f(x)
        let compiledDeriv = null;    // 編譯後的導函數 f'(x)

        const ruleNames = { product: '乘積律', chain: '連鎖律', sum: '和差律', quotient: '商法則' };

        // 核心 1：利用 AST 判斷最外層的法則
        function analyzeAST(node) {
            if (node.isOperatorNode) {
                if (node.op === '+' || node.op === '-') return 'sum';
                if (node.op === '*') return 'product';
                if (node.op === '/') return 'quotient';
                if (node.op === '^') return 'chain'; 
            } else if (node.isFunctionNode) {
                return 'chain';
            }
            return 'sum'; // 預設降級
        }

        // 核心 2：動態產生步驟 (轉換成 LaTeX 語法給 KaTeX 渲染)
        function generateSteps(node, rule) {
            let steps = [];
            const texNode = node.toTex();
            const derivNode = math.derivative(node, 'x');
            const texDeriv = derivNode.toTex();

            if (rule === 'product') {
                const u = node.args[0]; const v = node.args[1];
                const du = math.derivative(u, 'x'); const dv = math.derivative(v, 'x');
                steps = [
                    ['辨識兩個乘積因子 (u 與 v)', `$$u = ${u.toTex()}, \\quad v = ${v.toTex()}$$`],
                    ['分別對 u, v 進行求導', `$$u' = ${du.toTex()}, \\quad v' = ${dv.toTex()}$$`],
                    ['套用乘積律公式', `$$f'(x) = u'v + uv'$$`],
                    ['代入並組合答案', `$$f'(x) = (${du.toTex()})(${v.toTex()}) + (${u.toTex()})(${dv.toTex()})$$`]
                ];
            } else if (rule === 'quotient') {
                const u = node.args[0]; const v = node.args[1];
                const du = math.derivative(u, 'x'); const dv = math.derivative(v, 'x');
                steps = [
                    ['辨識分子 u 與分母 v', `$$u = ${u.toTex()}, \\quad v = ${v.toTex()}$$`],
                    ['分別求導 u 與 v', `$$u' = ${du.toTex()}, \\quad v' = ${dv.toTex()}$$`],
                    ['套用商法則 (下乘上導 - 上乘下導) / 下平方', `$$f'(x) = \\frac{u'v - uv'}{v^2}$$`],
                    ['代入並組合答案', `$$f'(x) = \\frac{(${du.toTex()})(${v.toTex()}) - (${u.toTex()})(${dv.toTex()})}{(${v.toTex()})^2}$$`]
                ];
            } else if (rule === 'sum') {
                steps = [
                    ['辨識加減法結構', `$$f(x) = ${texNode}$$`],
                    ['分配求導運算元', `$$f'(x) = \\frac{d}{dx}[${texNode}]$$`],
                    ['各項獨立求導', `(系統自動處理每一項的導數)`],
                    ['組合最終答案', `$$f'(x) = ${texDeriv}$$`]
                ];
            } else {
                // Chain Rule 預設處理
                steps = [
                    ['辨識複合函數 (洋蔥結構)', `$$f(x) = ${texNode}$$`],
                    ['對最外層函數進行求導', `外層導數保留內層不變`],
                    ['對內部函數進行求導 (連鎖律)', `掛上內部函數的導數`],
                    ['組合最終答案', `$$f'(x) = ${texDeriv}$$`]
                ];
            }
            return steps;
        }

        function feedback(message, success=false) {
            $('rule-feedback').textContent = message;
            $('rule-feedback').style.color = success ? '#8cdda8' : '#f3c978';
        }

        function selectRule(rule) {
            document.querySelectorAll('.rule').forEach(b => b.classList.toggle('selected', b.dataset.rule === rule));
            if(rule === currentRule) {
                feedback(`正確！系統判定最外層適用「${ruleNames[rule]}」。`, true);
                $('step-slider').value = 1;
                renderStep();
            } else {
                feedback(`再試一次：請觀察最外層的運算符號。`);
            }
        }

        function renderStep() {
            const i = Number($('step-slider').value);
            const step = currentSteps[i];
            $('step-count').textContent = `步驟 ${i} / 3`;
            $('step-heading').textContent = step[0];
            $('step-content').innerHTML = step[1];
            // 呼叫 KaTeX 渲染數學式
            renderMathInElement($('step-content'), { throwOnError: false });
        }

        // 處理主邏輯：當使用者提交公式時
        function loadMathFunction(exprStr) {
            try {
                // 1. Math.js 解析 AST
                currentAst = math.parse(exprStr);
                
                // 2. 判別法則與產生步驟
                currentRule = analyzeAST(currentAst);
                currentSteps = generateSteps(currentAst, currentRule);
                
                // 3. 準備畫圖所需的編譯函數
                compiledFunc = currentAst.compile();
                compiledDeriv = math.derivative(currentAst, 'x').compile();

                // 4. 更新 UI 介面
                $('current-function').innerHTML = `$$f(x) = ${currentAst.toTex()}$$`;
                renderMathInElement($('current-function'), { throwOnError: false });
                
                $('graph-formula').innerHTML = `$$f'(x) = ${math.derivative(currentAst, 'x').toTex()}$$`;
                renderMathInElement($('graph-formula'), { throwOnError: false });

                document.querySelectorAll('.rule').forEach(b => b.classList.remove('selected'));
                feedback(`成功解析！請在下方判斷並拖曳適用的規則積木。`, true);
                
                $('step-slider').value = 0;
                renderStep();
                renderGraph();
            } catch (e) {
                feedback('語法解析失敗，請檢查函數格式（例：用 * 表示乘法，支援 sin, cos, exp 等）');
                console.error(e);
            }
        }

        function fmt(n) { return Math.abs(n)<0.0005 ? '0' : n.toFixed(3); }

        function renderGraph() {
            if(!window.Chart || !compiledFunc) return;
            
            const x = Number($('x-slider').value);
            let y, slope;
            try {
                y = compiledFunc.evaluate({x: x});
                slope = compiledDeriv.evaluate({x: x});
            } catch(e) { return; } // 防止特定 x 值（如 log(-1)）導致報錯

            $('point-value').textContent = `(${fmt(x)}, ${fmt(y)})`;
            $('slope-value').textContent = fmt(slope);
            
            // 產生曲線資料點
            const range = 3;
            const pts = [];
            for(let i=0; i<=100; i++){
                const currX = -range + 2 * range * i / 100;
                try {
                    const currY = compiledFunc.evaluate({x: currX});
                    // 排除無效值或過大的漸近線干擾
                    if(typeof currY === 'number' && !isNaN(currY) && Math.abs(currY) < 50) {
                        pts.push({x: currX, y: currY});
                    }
                } catch(e) {}
            }

            const reach = range * 0.4;
            const sets = [
                {label:'f(x)', data:pts, borderColor:'#71b9ff', borderWidth:3, pointRadius:0, showLine:true},
                {label:'切線', data:[{x: x-reach, y: y-slope*reach}, {x: x+reach, y: y+slope*reach}], borderColor:'#f3c978', borderWidth:2, pointRadius:0, showLine:true, borderDash:[7,5]},
                {label:'切點', data:[{x, y}], borderColor:'#8cdda8', backgroundColor:'#8cdda8', pointRadius:6, pointHoverRadius:8}
            ];

            if(chart) {
                chart.data.datasets = sets;
                chart.update('none');
            } else {
                chart = new Chart($('function-chart'),{
                    type:'scatter', data:{datasets:sets},
                    options:{
                        responsive:true, maintainAspectRatio:false, animation:false,
                        plugins:{legend:{labels:{color:'#c9d7da',usePointStyle:true}}, tooltip:{callbacks:{label:c=>`(${fmt(c.parsed.x)}, ${fmt(c.parsed.y)})`}}},
                        scales:{
                            x:{type:'linear', min:-range, max:range, grid:{color:'#354553'}, border:{color:'#607582'}, ticks:{color:'#aebfc7'}},
                            y:{grid:{color:'#354553'}, border:{color:'#607582'}, ticks:{color:'#aebfc7'}}
                        }
                    }
                });
            }
        }

        // ==================== 事件綁定 ====================
        $('function-form').addEventListener('submit', e => {
            e.preventDefault();
            loadMathFunction($('function-input').value);
            document.querySelectorAll('.sample').forEach(b => b.classList.remove('active'));
        });

        document.querySelectorAll('.sample').forEach(b => {
            b.addEventListener('click', () => {
                $('function-input').value = b.dataset.example;
                document.querySelectorAll('.sample').forEach(btn => btn.classList.remove('active'));
                b.classList.add('active');
                loadMathFunction(b.dataset.example);
            });
        });

        document.querySelectorAll('.rule').forEach(b => {
            b.addEventListener('click', () => selectRule(b.dataset.rule));
            b.addEventListener('dragstart', e => e.dataTransfer.setData('text/plain', b.dataset.rule));
        });
        
        const drop = $('drop-target');
        drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('drag-over'); });
        drop.addEventListener('dragleave', () => drop.classList.remove('drag-over'));
        drop.addEventListener('drop', e => {
            e.preventDefault(); 
            drop.classList.remove('drag-over');
            const rule = e.dataTransfer.getData('text/plain');
            if(ruleNames[rule]) selectRule(rule);
        });
        
        $('step-slider').addEventListener('input', renderStep);
        $('x-slider').addEventListener('input', renderGraph);

        // 修改 switchTab 行為以確保切換時圖表正常載入
        const originalSwitchTab = switchTab;
        window.switchTab = function(tabId) {
            originalSwitchTab(tabId);
            if (tabId === 'tool') {
                setTimeout(() => {
                    if(!chart) loadMode('product'); 
                    else chart.resize();
                }, 100);
            }
        };
        
        // Check Progress
        function saveProgress() {
            const checks = ['check-1', 'check-2', 'check-3', 'check-4'];
            let cCount = 0;
            checks.forEach(id => {
                const el = document.getElementById(id);
                localStorage.setItem('m2-unit7-' + id, el.checked);
                if (el.checked) cCount++;
            });
            const pct = Math.round((cCount / checks.length) * 100);
            document.getElementById('progress-text').innerText = `${pct}%`;
            document.getElementById('progress-bar').style.width = `${pct}%`;
        }

        function loadProgress() {
            const checks = ['check-1', 'check-2', 'check-3', 'check-4'];
            checks.forEach(id => {
                const saved = localStorage.getItem('m2-unit7-' + id);
                if (saved === 'true') document.getElementById(id).checked = true;
            });
            saveProgress();
        }

        window.onload = function() {
            loadProgress();
            setTimeout(() => { loadMathFunction('x^2 * sin(x)'); }, 500);
        };
    </script>
</body>
</html>
